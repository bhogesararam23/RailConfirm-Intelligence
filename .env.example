# Copy this file to .env for local development.
# Do not place real keys or credentials in this template or in Git history.

APP_ENV=development
LOG_LEVEL=INFO

# Configure only after the API/database implementation exists.
DATABASE_URL=

# Provider credentials must come from a separately approved integration.
# PNR_PROVIDER_BASE_URL=
# PNR_PROVIDER_API_KEY=

# Never enable a live provider adapter without reviewing docs/SECURITY_AND_PRIVACY.md
# and the applicable entry in docs/data/SOURCE_REGISTER.md.
