# Copy this file to .env at the repository root for local development.
# Do not place real keys or credentials in this template or in Git history.
#
# Settings are read by backend/railconfirm/config.py with the RAILCONFIRM_
# prefix. Every value below is optional: the defaults keep the application in
# local-first, abstain-by-default behaviour.

# ── Application ────────────────────────────────────────────────────────────────
# RAILCONFIRM_DEBUG=false

# ── Local server ───────────────────────────────────────────────────────────────
# Loopback by default. Binding to 0.0.0.0 exposes an unauthenticated development
# API to the network; see docs/SECURITY_AND_PRIVACY.md before doing that.
# RAILCONFIRM_HOST=127.0.0.1
# RAILCONFIRM_PORT=8000

# ── HTTP boundary ──────────────────────────────────────────────────────────────
# Browser origins allowed to call the API. JSON list, explicit origins only: '*'
# and empty entries are refused. The development frontend is on port 3000.
# NB: port 3000 is a local Grafana on the maintainer's machine, so run the
# frontend on another port and list that origin here instead.
# RAILCONFIRM_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Largest request body the API accepts, in bytes.
# RAILCONFIRM_MAX_REQUEST_BYTES=65536

# ── Paths (relative paths resolve against the repository root) ─────────────────
# RAILCONFIRM_DATA_DIR=data/processed
# RAILCONFIRM_MODELS_DIR=models

# ── Model registry ─────────────────────────────────────────────────────────────
# The active artifact is models/<version>.json. "no_model_v0" means nothing is
# promoted and every prediction abstains. Placing a file in models/ does NOT
# activate it: the version must be named here, and the artifact's own metadata
# must declare promotion "approved_for_local_use".
# RAILCONFIRM_ACTIVE_MODEL_VERSION=no_model_v0

# ── Inference guards ───────────────────────────────────────────────────────────
# Smallest cohort the historical-frequency baseline will report an estimate for.
# RAILCONFIRM_MIN_SAMPLE_THRESHOLD=30
# Largest model artifact the registry will read, in bytes.
# RAILCONFIRM_MAX_ARTIFACT_BYTES=4194304

# ── Provenance reporting ───────────────────────────────────────────────────────
# Identifies the dataset version reported by GET /v1/health.
# RAILCONFIRM_DATA_VERSION=none

# No third-party runtime integration is configured or permitted in roadmap
# Phases 0-7 (ADR-0007). Provider credentials belong to a later, separately
# authorised phase and must never be committed.
#
# PNR_PROVIDER_BASE_URL=
# PNR_PROVIDER_API_KEY=

# Never enable a live provider adapter without reviewing
# docs/SECURITY_AND_PRIVACY.md and the applicable entry in
# docs/data/SOURCE_REGISTER.md.
